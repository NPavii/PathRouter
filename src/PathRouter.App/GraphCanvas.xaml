<UserControl
    x:Class="PathRouter.App.GraphCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid Background="#FAFBFD">
        <canvas:CanvasControl x:Name="Canvas"
                              Draw="OnDraw"
                              CreateResources="OnCreateResources"
                              PointerPressed="OnPointerPressed"
                              PointerMoved="OnPointerMoved"
                              PointerReleased="OnPointerReleased"
                              PointerWheelChanged="OnPointerWheelChanged"
                              DoubleTapped="OnDoubleTapped"
                              RightTapped="OnRightTapped" />
        <Border x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F0F2F7" CornerRadius="8" Padding="20,12" IsHitTestVisible="False">
            <TextBlock Text="Перетащите файлы слева, чтобы создать первый маршрут&#x0a;Колесо мыши — масштаб, перетаскивание фона — панорама"
                       TextAlignment="Center" Foreground="#667" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
