<Window
    x:Class="PathRouter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PathRouter.App"
    Title="Караван">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RoutesColumn" Width="410" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- ===== Левая панель ===== -->
        <Grid Grid.Column="0" Background="#F3F4F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Padding="14" MaxHeight="360">
                <StackPanel Spacing="10">
                    <TextBlock Text="Новый маршрут" FontSize="18" FontWeight="SemiBold" />

                    <!-- Зона Drop -->
                    <Border x:Name="DropZone" Height="96" CornerRadius="10"
                            Background="#E8ECF7" BorderBrush="#B9C6EE" BorderThickness="1.5"
                            AllowDrop="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="#4F6BED" />
                            <TextBlock x:Name="DropHint" Text="Перетащите сюда файлы или папку"
                                       TextAlignment="Center" FontSize="12" Foreground="#556" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="RouteNameBox" PlaceholderText="Название пути (напр. «Автомат коробов — документация»)" />

                    <Button x:Name="PickSourceButton" Click="OnPickSource" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="Указать исходную папку…" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PickDestButton" Click="OnPickDest" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock x:Name="DestPathText" Text="Выбрать папку назначения…" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PutButton" Click="OnPut" Content="Положить"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" IsEnabled="False" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="14,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Поиск маршрута…" TextChanged="OnSearchChanged" Margin="0,6,0,8" />
                <TextBox x:Name="FileSearchBox" Grid.Row="1" PlaceholderText="Найти файл по всем путям…"
                         TextChanged="OnFileSearchChanged" Margin="0,0,0,8" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="2,0,0,8">
                    <CheckBox x:Name="ShowArchived" Content="Архивные" IsChecked="False" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                    <CheckBox x:Name="ShowHidden" Content="Скрытые" IsChecked="False" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="2,0,0,10">
                    <Button Content="Экспорт БД" FontSize="11.5" Padding="8,3" Click="OnExportDb"
                            ToolTipService.ToolTip="Сохранить базу маршрутов (SQLite) в файл" />
                    <Button Content="Импорт БД…" FontSize="11.5" Padding="8,3" Click="OnImportDb"
                            ToolTipService.ToolTip="Заменить текущую базу маршрутов файлом" />
                </StackPanel>
                <Grid Grid.Row="4">
                    <ListView x:Name="RoutesList" SelectionMode="Extended" RightTapped="OnRoutesRightTapped"
                              SelectionChanged="OnRouteSelectionChanged">
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="RouteContextMenu" Opening="OnRouteMenuOpening">
                            <MenuFlyoutItem x:Name="MergeMenuItem" Text="Объединить выбранные в путь…" Click="OnMergeRoutes" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CollapseRouteItem" Text="Свернуть маршрут" Click="OnToggleRouteCollapse" />
                            <MenuFlyoutItem x:Name="CollapseGroupItem" Text="Свернуть путь" Click="OnToggleGroupCollapse" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="UngroupItem" Text="Убрать из пути" Click="OnUngroupSelected" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,2"
                                          Visibility="{Binding Key, Converter={StaticResource NonEmptyToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="12" Foreground="#4F6BED" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#2B4ACB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="{Binding IsCollapsed, Converter={StaticResource CollapseText}}"
                                                FontSize="11" Padding="6,2" Margin="6,0,0,0" Click="OnGroupHeaderCollapse" />
                                        <Button Grid.Column="3" Content="✕" FontSize="11" Padding="6,2" Margin="2,0,0,0"
                                                ToolTipService.ToolTip="Разгруппировать маршруты" Click="OnGroupHeaderUngroup" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="#778">
                                        <Run Text="{Binding SourcePath}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="#F7630C"
                                              Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xE7B8;" FontSize="13" Foreground="#99A"
                                              Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xED1A;" FontSize="13" Foreground="#99A"
                                              Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xE96E;" FontSize="13" Foreground="#99A"
                                              Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Результаты поиска файла: все известные копии по всем маршрутам -->
                <Border x:Name="FileResultsPanel" Visibility="Collapsed" VerticalAlignment="Top"
                        Background="#FFFFFF" BorderBrush="#C8CBD6" BorderThickness="1" CornerRadius="8"
                        MaxHeight="280" Padding="6" Canvas.ZIndex="10">
                    <ListView x:Name="FileResultsList" IsItemClickEnabled="True" ItemClick="OnFileResultClick"
                              DoubleTapped="OnFileResultDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="#778" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding RouteName}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding DestPath}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#99A" VerticalAlignment="Center"
                                               Text="{Binding Size}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                </Grid>
            </Grid>

            <!-- Действия с выбранным маршрутом -->
            <Border Grid.Row="2" Background="#EBEDF4" Padding="10">
                <ContentControl x:Name="RouteActions" IsEnabled="False">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SelectedRouteTitle" Text="Маршрут не выбран" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="В новую папку…" Click="OnAddDestination" FontSize="11.5" Padding="6,4" />
                            <Button Content="Обновить все" Click="OnUpdateAll" FontSize="11.5" Padding="6,4" />
                            <Button Content="Открыть источник" Click="OnOpenSource" FontSize="11.5" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Переименовать" Click="OnRename" FontSize="11.5" Padding="6,4" />
                            <Button x:Name="ArchiveButton" Content="Архивировать" Click="OnToggleArchive" FontSize="11.5" Padding="6,4" />
                            <Button x:Name="HideButton" Content="Скрыть" Click="OnToggleHide" FontSize="11.5" Padding="6,4" />
                            <Button Content="Удалить" Click="OnDelete" FontSize="11.5" Padding="6,4"
                                    Background="#C42B1C" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>

        <Rectangle Grid.Column="1" Fill="#D8DBE4" />

        <!-- ===== Граф ===== -->
        <Grid Grid.Column="2">
            <local:GraphCanvas x:Name="Graph" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                <Button x:Name="TogglePanelButton" Click="OnTogglePanel" ToolTipService.ToolTip="Свернуть/развернуть панель маршрутов">
                    <FontIcon x:Name="TogglePanelIcon" Glyph="&#xE89F;" FontSize="14" />
                </Button>
                <Button Content="Проверить обновления" Click="OnCheckUpdates" />
                <Button Content="Сбросить вид" Click="OnResetView" />
            </StackPanel>
            <ProgressRing x:Name="BusyRing" Width="36" Height="36" IsActive="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        </Grid>

        <!-- Статус -->
        <Border Grid.Row="1" Background="#2B2E3A" Padding="12,5">
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="#DDE" FontSize="12" />
        </Border>
    </Grid>
</Window>
