<Application
    x:Class="PathRouter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PathRouter.App"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisConverter x:Key="BoolToVisibilityConverter" />
            <local:NonEmptyStringToVisConverter x:Key="NonEmptyToVis" />
            <local:CollapseTextConverter x:Key="CollapseText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
